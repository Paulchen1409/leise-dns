{
  "name": "leise-dns", "version": "0.5.0", "private": true,
  "description": "Lokaler DNS-Adblocker für deinen Windows-PC", "author": "Local", 
  "main": "src/main/main.js",
  "scripts": {"start": "electron .", "test": "node --test tests/*.test.js", "smoke": "electron . --smoke-test", "pack": "electron-builder --dir", "dist": "electron-builder --win nsis"},
  "engines": {"node": ">=22.16"},
  "dependencies": {"chart.js": "^4.5.0", "dns-packet": "^5.6.1"},
  "devDependencies": {"electron": "^42.0.0", "electron-builder": "^26.0.12"},
  "build": {"appId": "de.local.leisedns", "productName": "Leise DNS", "asarUnpack": ["src/platform/*.ps1"], "files": ["src/**/*", "assets/**/*", "package.json"], "win": {"target": "nsis", "icon":"assets/icon.ico"}, "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}}
}
